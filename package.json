{
  "name": "yume-haze-zapret",
  "productName": "Yume Haze Zapret",
  "version": "2.3.0",
  "description": "Графическая оболочка для Zapret (Flowseal) и TG WS Proxy",
  "main": "main.js",
  "author": {
    "name": "Yume Haze",
    "email": "nobucraft@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "selftest": "node scripts/selftest.js",
    "dist:win": "electron-builder --win nsis portable --x64",
    "test:ui": "xvfb-run -a node scripts/ui-check.js",
    "test:smoke": "xvfb-run -a node scripts/electron-smoke.js",
    "assets": "node scripts/gen-assets.js",
    "dist": "electron-builder --win nsis portable --x64",
    "dist:nsis": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "pack": "electron-builder --win --dir",
    "dist:linux": "electron-builder --linux AppImage deb tar.gz --x64",
    "linux:engine": "make -C linux/engine",
    "test:linux": "node scripts/linux-test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.yumehaze.zapret",
    "productName": "Yume Haze Zapret",
    "copyright": "Copyright © 2026 Yume Haze",
    "directories": {
      "output": "release",
      "buildResources": "res"
    },
    "compression": "normal",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "res/icon.ico",
      "res/icon.png",
      "linux/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "res/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "YumeHazeZapret-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Yume Haze Zapret",
      "uninstallDisplayName": "Yume Haze Zapret ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "res/icon.ico",
      "uninstallerIcon": "res/icon.ico",
      "installerHeaderIcon": "res/icon.ico"
    },
    "portable": {
      "artifactName": "YumeHazeZapret-${version}-${arch}-portable.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "YumeHazeZapret"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YumeHazeZapret-${version}-${arch}.${ext}",
      "icon": "res/icon.png",
      "category": "Network",
      "synopsis": "Обход блокировок для Windows и Linux",
      "description": "Yume Haze Zapret — графическая оболочка для zapret (Flowseal): обход блокировок Discord, YouTube и других сервисов. Работает в Windows и Linux.",
      "desktop": {
        "entry": {
          "Name": "Yume Haze Zapret",
          "Comment": "Обход блокировок Discord и YouTube",
          "Categories": "Network;Utility;",
          "Keywords": "zapret;vpn;proxy;discord;youtube;"
        }
      },
      "maintainer": "Yume Haze <nobucraft@users.noreply.github.com>"
    }
  },
  "homepage": "https://github.com/NobuCraft/yume-haze-zapret",
  "repository": {
    "type": "git",
    "url": "https://github.com/NobuCraft/yume-haze-zapret.git"
  },
  "bugs": {
    "url": "https://github.com/NobuCraft/yume-haze-zapret/issues"
  }
}